# Copy to .env and fill in your own values. Never commit real values.

# --- Client (bundled into the app; public by design) ---
EXPO_PUBLIC_SUPABASE_URL=YOUR_PROJECT_URL
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
EXPO_PUBLIC_GOOGLE_TAG_ID=
EXPO_PUBLIC_META_PIXEL_ID=
EXPO_PUBLIC_BMC_URL=
EXPO_PUBLIC_SUPPORTER_KEYS=
EXPO_PUBLIC_TIP_ANY=
EXPO_PUBLIC_TIP_5=
EXPO_PUBLIC_TIP_10=

# --- Server only (Vercel API routes). Set in Vercel, never in client code ---
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
CRON_SECRET=YOUR_CRON_SECRET
FIREBASE_SERVICE_ACCOUNT=YOUR_FIREBASE_SERVICE_ACCOUNT_JSON
